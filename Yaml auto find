name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Unpack project
        run: unzip -q vpn_glass.zip

      - name: Create Android scaffold
        working-directory: vpn_glass
        run: |
          flutter create . --platforms=android --org com.vpnglass
          sed -i 's#<application#<uses-permission android:name="android.permission.INTERNET"/>\n    <application#' android/app/src/main/AndroidManifest.xml
          sed -i 's/flutter.minSdkVersion/23/' android/app/build.gradle* || true

      - name: Build APK
        working-directory: vpn_glass
        run: |
          flutter pub get
          flutter build apk --release --split-per-abi

      - uses: actions/upload-artifact@v4
        with:
          name: vpn-glass-apk
          path: vpn_glass/build/app/outputs/flutter-apk/*.apk
